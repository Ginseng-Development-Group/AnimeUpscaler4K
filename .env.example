# ============================================================
# AnimeUpscaler4K — Environment Configuration
# Copy this file to `.env` and adjust to match your hardware.
# ============================================================

# --- Host Directory Paths (mounted into Docker) ---
HOST_INPUT_DIR=./data/input
HOST_OUTPUT_DIR=./data/output
HOST_WORKSPACE_DIR=./data/workspace

# --- GPU & Real-CUGAN Configuration ---
# Comma-separated Vulkan GPU indices (e.g., "0" for single GPU, "0,1" for dual GPU)
CUGAN_GPUS=0,1

# Model folder: "models-pro" (recommended highest quality), "models-se", or "models-nose"
CUGAN_MODEL=models-pro

# Upscale factor: 2 (1080p -> 4K), 3 (720p -> 4K), or 4
CUGAN_SCALE=2

# Denoise level: -1 (conservative/preserve grain), 0 (no denoise), 1, 2, or 3 (aggressive)
CUGAN_NOISE=-1

# Real-CUGAN threads (load:proc:save).
# Use "2:2:2" for >=12GB VRAM GPUs (RTX 3090 / 4070 SUPER).
# Lower to "1:1:1" for 6-8GB VRAM GPUs.
CUGAN_THREADS=2:2:2

# --- Streaming / Chunked Disk Budget ---
# Number of frames extracted & upscaled per chunk before encoding to MKV and deleting PNGs.
# 14385 frames (~10 mins @ 23.976fps) uses ~20-25 GB of temporary disk per active GPU.
# 7200 frames (~5 mins) uses ~10-12 GB; 3600 frames (~2.5 mins) uses ~5-6 GB.
CHUNK_SIZE=14385

# --- Video Encoding ---
# "hevc_nvenc" (NVIDIA GPU hardware encoder - fastest)
# "hevc_vaapi" (AMD/Intel Linux VAAPI hardware encoder)
# "libx265"    (CPU software encoder fallback)
VIDEO_ENCODER=hevc_nvenc

# Encoder preset ("p7" highest quality for hevc_nvenc; "slow" or "medium" for libx265)
VIDEO_PRESET=p7

# Constant Quality (CQ for NVENC / CRF for libx265). 16 = near-lossless 10-bit OLED master.
VIDEO_CQ=16

# --- Optional Jellyfin Integration ---
# Leave blank to disable automatic library refresh after each movie/episode completes.
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
